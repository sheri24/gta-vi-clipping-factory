# Copy to .env and fill in. Never commit .env.
YOUTUBE_API_KEY=

# Where the database, recordings, clips, models and logs live (relative to the project folder, or an absolute
# path on a drive with space, e.g. D:/clipfactory-data)
DATA_DIR=data

# How often to check channels for live streams
POLL_INTERVAL_SECONDS=60

# Probe youtube.com/channel/<id>/live each poll (free, no quota). RSS alone can miss streams.
LIVE_PAGE_PROBE=true

# Daily unit budget we allow ourselves on the shared Data API bucket (Google default is 10000)
QUOTA_DAILY_BUDGET=9000

# --- Recording (Phase 3). Only channels with record_enabled=true are recorded. ---
# Streamlink quality, first available wins. 720p60 is ~1-2.8 GB/hour depending on scene.
RECORD_QUALITY=720p60,720p,best
# Length of each saved piece of footage
SEGMENT_SECONDS=60
# While live, keep only the last N minutes (older pieces are deleted unless a clip needs them)
BUFFER_MINUTES=30
# After a stream ends, wait this long (for final clips), then delete all its footage
END_CLEANUP_GRACE_MINUTES=10
# Don't start new recordings if the drive has less free space than this
MIN_FREE_GB=10
# How often to re-sync recording time to YouTube's clock
ANCHOR_INTERVAL_MINUTES=10

# --- Captions (Phase 7) ---
# openai = official openai-whisper, weights from OpenAI's CDN (works when Hugging Face is blocked)
# faster = faster-whisper, ~2-3x faster, but downloads weights from Hugging Face
WHISPER_BACKEND=openai
WHISPER_MODEL=small
# Free Hugging Face READ token (huggingface.co → Settings → Access Tokens). Only used to download the
# Whisper model once; without it, anonymous downloads can be rate-limited (HTTP 429).
HF_TOKEN=

# --- Spike detection (Phase 5) ---
# A 10 s bucket is a spike when distinct chatters are well above the median of the last few minutes
SPIKE_BASELINE_MINUTES=5
SPIKE_MIN_HISTORY_MINUTES=2
SPIKE_Z=3.5
SPIKE_RATIO=1.6
SPIKE_MIN_AUTHORS=5
SPIKE_MERGE_GAP_SECONDS=20
# Clip length around the estimated moment (15 s before + 25 s after = 40 s)
CLIP_PRE_SECONDS=15
CLIP_POST_SECONDS=25
# Delete a clip's local files (source, vertical, final video, captions) once it is posted.
# The grace period leaves time to re-upload if YouTube processing fails. 0 = delete right away.
CLIP_PURGE_AFTER_PUBLISH=true
CLIP_PURGE_GRACE_MINUTES=60

# --- Past streams (VOD mode): clip finished streams from their chat replay while nobody is live ---
VOD_ENABLED=true
VOD_SCAN_MINUTES=30
VOD_MAX_AGE_HOURS=72
VOD_MIN_MINUTES=20
# A stream is clipped only if its title contains one of these (empty = any title). Pasted links skip this.
VOD_TITLE_KEYWORDS=gta 6,gta vi,gta6,gtavi,grand theft auto
VOD_MAX_CLIPS=6
# Smaller bursts aren't worth a clip from a past stream
VOD_MIN_PEAK_CHATTERS=10
# Chat lag for channels never recorded live (measured live: Lacy 39.8 s)
VOD_CHAT_DELAY_SECONDS=35
VOD_PAUSE_WHILE_LIVE=true

# Delete a rejected clip's local files this long after it was rejected (time to look and overrule)
CLIP_PURGE_REJECTED=true
CLIP_PURGE_REJECTED_MINUTES=360

# --- Posting strategy: clips are made around the clock, posted in slots over the audience's evening ---
# Slot times on the audience's clock (empty = post as soon as a clip is ready)
PUBLISH_SLOTS=12:00,14:30,17:00,19:00,21:00,23:00
PUBLISH_SLOTS_TIMEZONE=America/New_York
# A live clip with at least this AI score, this many minutes after the moment, posts immediately
PUBLISH_BREAKING_SCORE=8.0
PUBLISH_BREAKING_MINUTES=120
# Moments older than this are dropped instead of posted
PUBLISH_MAX_AGE_HOURS=96
PUBLISH_MAX_PER_STREAM_PER_DAY=2

# --- AI review (local Ollama; the model must accept images) ---
OLLAMA_URL=http://127.0.0.1:11434
QC_MODEL=gemma4:e2b
# 0-10: clips at or above this pass the review and get rendered
QC_MIN_SCORE=6.0
# NudeNet confidence (0-1) at which exposed genitals/buttocks/breasts reject a clip. Lower = stricter.
QC_NUDITY_THRESHOLD=0.4
# Text model for titles (empty = same as QC_MODEL)
METADATA_MODEL=

# --- Publishing to YouTube (needs the one-time sign-in: python -m app.publish.auth) ---
PUBLISH_ENABLED=false
PUBLISH_PRIVACY=public
PUBLISH_INTERVAL_MINUTES=30
PUBLISH_MAX_PER_DAY=6

# Phone alerts. ntfy (free, no account): run .venv\Scripts\python -m app.notify.ntfy
NTFY_TOPIC=
# Telegram alerts (free). Token from @BotFather, then run: .venv\Scripts\python -m app.notify.telegram
TELEGRAM_BOT_TOKEN=
NOTIFY_LIVE=true
